<Slide style={{
    width: 1280,
    height: 720,
    background: '#FFFFFF',
    position: 'relative',
    display: 'flex',
    flexDirection: 'column',
    padding: '36px 60px'
}}>
    {/* 左下浅蓝装饰圆斑 */}
    <Box style={{
        position: 'absolute', bottom: -120, left: -120,
        width: 320, height: 320, borderRadius: '50%',
        background: 'radial-gradient(circle, rgba(30, 136, 229, 0.10) 0%, rgba(30, 136, 229, 0) 70%)'
    }} />

    {/* A 区：标题块 */}
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, position: 'relative', zIndex: 2 }}>
        <Box style={{
            width: 6, height: 36, background: 'linear-gradient(180deg, #0B2545 0%, #1E88E5 100%)',
            borderRadius: 3
        }} />
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#0B2545', letterSpacing: 1 }}>
            团队概况
        </Text>
        <Box style={{
            background: '#E3F2FD', padding: '4px 14px', borderRadius: 14,
            marginLeft: 8
        }}>
            <Text style={{ fontSize: 13, color: '#0B2545', fontWeight: 'bold' }}>
                6 名队员 + 2 位指导老师
            </Text>
        </Box>
    </Box>

    {/* B 区：内容区 */}
    <Box style={{ flex: 1, flexDirection: 'column', gap: 14, marginTop: 16, position: 'relative', zIndex: 2 }}>
        {/* 指导老师横排 */}
        <Box style={{ flexDirection: 'row', gap: 16 }}>
            <Box style={{
                background: 'linear-gradient(135deg, #0B2545 0%, #1E88E5 100%)',
                borderRadius: 12, padding: '14px 22px', alignItems: 'center', justifyContent: 'center'
            }}>
                <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>师 指导老师</Text>
            </Box>
            {['张红朗', '董怡静'].map((name, i) => (
                <Box key={i} style={{
                    background: '#E3F2FD', borderRadius: 12, padding: '14px 22px',
                    flex: 1, justifyContent: 'center', alignItems: 'center',
                    border: '1px solid rgba(30, 136, 229, 0.3)'
                }}>
                    <Text style={{ fontSize: 18, color: '#0B2545', fontWeight: 'bold' }}>{name}</Text>
                </Box>
            ))}
        </Box>

        {/* 队长大卡片 */}
        <Box style={{
            background: 'linear-gradient(135deg, #E3F2FD 0%, #D6EBFF 100%)',
            borderRadius: 12, padding: '16px 22px',
            borderLeft: '5px solid #0B2545',
            flexDirection: 'row', alignItems: 'center', gap: 18
        }}>
            <Box style={{
                background: '#FFFFFF', borderRadius: '50%',
                width: 64, height: 64, justifyContent: 'center', alignItems: 'center',
                border: '2px solid #1E88E5'
            }}>
                <Text style={{ fontSize: 32 }}>队</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', gap: 4 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Text style={{ fontSize: 22, color: '#0B2545', fontWeight: 'bold' }}>阎宗宁</Text>
                    <Box style={{
                        background: '#0B2545', padding: '3px 12px', borderRadius: 12
                    }}>
                        <Text style={{ fontSize: 12, color: '#FFFFFF', fontWeight: 'bold' }}>队长</Text>
                    </Box>
                </Box>
                <Text style={{ fontSize: 13, color: '#475569' }}>
                    2025 级药品质量与安全 01 班 · 学号 202502010105
                </Text>
            </Box>
        </Box>

        {/* 5 队员卡片 */}
        <Box style={{ flexDirection: 'row', gap: 12 }}>
            {[
                { name: '祝鸣轩', cls: '药品质量与安全 01 班', sid: '202502010141' },
                { name: '李响',   cls: '药品质量与安全 01 班', sid: '202502010128' },
                { name: '郭亦彤', cls: '食品药品监督管理 02 班', sid: '202502040239' },
                { name: '陈虹宇', cls: '医学检验技术 03 班',   sid: '202502050305' },
                { name: '段文烁', cls: '食品药品监督管理 02 班', sid: '202502040208' }
            ].map((m, i) => (
                <Box key={i} style={{
                    flex: 1, background: '#FFFFFF', borderRadius: 10,
                    padding: '14px 12px', alignItems: 'center',
                    border: '1px solid rgba(30, 136, 229, 0.3)',
                    borderTop: '3px solid #1E88E5'
                }}>
                    <Box style={{
                        background: '#E3F2FD', borderRadius: '50%',
                        width: 40, height: 40, justifyContent: 'center', alignItems: 'center',
                        marginBottom: 6
                    }}>
                        <Text style={{ fontSize: 22 }}>员</Text>
                    </Box>
                    <Text style={{ fontSize: 15, color: '#0B2545', fontWeight: 'bold' }}>{m.name}</Text>
                    <Text style={{ fontSize: 11, color: '#475569', marginTop: 2, textAlign: 'center' }}>{m.cls}</Text>
                    <Text style={{ fontSize: 10, color: '#64748B', marginTop: 1 }}>{m.sid}</Text>
                </Box>
            ))}
        </Box>

        {/* 团队亮点条 */}
        <Box style={{
            flexDirection: 'row', justifyContent: 'space-around',
            background: 'linear-gradient(135deg, #E3F2FD 0%, #D6EBFF 100%)',
            borderRadius: 10, padding: '12px 18px', marginTop: 4
        }}>
            <Box style={{ alignItems: 'center' }}>
                <Text style={{ fontSize: 22, color: '#0B2545', fontWeight: 'bold' }}>3 个</Text>
                <Text style={{ fontSize: 12, color: '#475569' }}>跨专业</Text>
            </Box>
            <Box style={{ alignItems: 'center' }}>
                <Text style={{ fontSize: 22, color: '#0B2545', fontWeight: 'bold' }}>6 人</Text>
                <Text style={{ fontSize: 12, color: '#475569' }}>团队总人数</Text>
            </Box>
            <Box style={{ alignItems: 'center' }}>
                <Text style={{ fontSize: 22, color: '#0B2545', fontWeight: 'bold' }}>2 位</Text>
                <Text style={{ fontSize: 12, color: '#475569' }}>指导老师</Text>
            </Box>
            <Box style={{ alignItems: 'center' }}>
                <Text style={{ fontSize: 22, color: '#0B2545', fontWeight: 'bold' }}>2025 级</Text>
                <Text style={{ fontSize: 12, color: '#475569' }}>全部大一</Text>
            </Box>
        </Box>
    </Box>

    {/* C 区：页脚 */}
    <Box style={{
        flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center',
        borderTop: '1px solid rgba(11, 37, 69, 0.15)', paddingTop: 12,
        position: 'relative', zIndex: 2
    }}>
        <Text style={{ fontSize: 12, color: '#64748B' }}>暖阳信语 · 星光伴成长</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{
                background: '#FFFFFF', borderRadius: 8, padding: 4,
                border: '1px solid rgba(30, 136, 229, 0.3)'
            }}>
                <Image src="assets/image1.jpg" style={{ width: 90, height: 60, objectFit: 'contain', borderRadius: 4 }} />
            </Box>
            <Text style={{ fontSize: 12, color: '#0B2545', fontWeight: 'bold' }}>02 / 05</Text>
        </Box>
    </Box>
</Slide>