<Slide style={{ padding: 60, background: '#FFFFFF', position: 'relative', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'column', height: '100%', gap: 24 }}>
        <Box style={{ flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.2 }}>再扫一次，还是那几道题</Text>
            <Box style={{ height: 3, width: '100%', background: '#E2E8F0' }} />
        </Box>
        <Box style={{ flexDirection: 'row', gap: 44, flex: 1 }}>
            <Box style={{ width: 340, flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 18, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 12 }}>
                <Image src="data:image/png;base64," style={{ width: 240, height: 240 }} />
                <Text style={{ fontSize: 16, color: '#64748B' }}>课后问卷二维码</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 26 }}>
                <Box style={{ flexDirection: 'column', gap: 8 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.5 }}>前面五道题，和刚才一模一样</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.7 }}>不用回头看自己选了什么，就按现在的想法选。</Text>
                </Box>
                <Box style={{ height: 1, background: '#E2E8F0' }} />
                <Box style={{ flexDirection: 'column', gap: 8 }}>
                    <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.5 }}>另加两道</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.7 }}>这次讲得清不清楚、对你有没有用，打 1 到 5 分。</Text>
                    <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.7 }}>还有一道：你打算什么时候开始练。这道题可以不填。</Text>
                </Box>
                <Box style={{ height: 1, background: '#E2E8F0' }} />
                <Text style={{ fontSize: 18, color: '#1D4ED8', lineHeight: 1.7, fontWeight: 'bold' }}>两列数字摆在一起，就知道这 40 分钟到底有没有用。</Text>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 24, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#CBD5E1' }}>山东药品食品职业学院 · 质量管理系 ·「童健韶华」志愿服务队</Text>
        <Text style={{ fontSize: 14, color: '#CBD5E1' }}>25</Text>
    </Box>
</Slide>
