        <Box style={{ flexDirection: 'row', gap: 44, flex: 1 }}>
            <Box style={{ width: 400, flexDirection: 'column', justifyContent: 'center', gap: 16 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 12 }}>
                    <Text style={{ fontSize: 120, fontWeight: 'bold', color: '#1D4ED8', lineHeight: 1 }}>2</Text>
                    <Text style={{ fontSize: 26, color: '#1D4ED8', lineHeight: 1.3 }}>学分</Text>
                </Box>
                <Text style={{ fontSize: 19, color: '#334155', lineHeight: 1.7 }}>完成体质健康测试，直接记 2 个第二课堂学分。这 2 分在文体素质拓展类里，是要修满 12 分的那一类。</Text>
                <Box style={{ height: 1, background: '#E2E8F0' }} />
