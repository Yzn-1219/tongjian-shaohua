<Slide style={{ padding: 60, background: '#FFFFFF', position: 'relative', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'column', height: '100%', gap: 24 }}>
        <Box style={{ flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.2 }}>先花 40 秒，回答几个问题</Text>
            <Box style={{ height: 3, width: '100%', background: '#E2E8F0' }} />
        </Box>
        <Box style={{ flexDirection: 'row', gap: 44, flex: 1 }}>
            <Box style={{ width: 340, flexDirection: 'column', alignItems: 'center', justifyContent: 'center', gap: 18, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 12 }}>
                <Image src="data:image/png;base64," style={{ width: 240, height: 240 }} />
                <Text style={{ fontSize: 16, color: '#64748B' }}>课前问卷二维码</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 28 }}>
                <Box style={{ flexDirection: 'row', gap: 18 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#EA580C' }}>01</Text>
                    <Box style={{ flexDirection: 'column', gap: 6 }}>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A' }}>不记名</Text>
                        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.6 }}>只统计到全年级一张总表，不落到任何个人头上</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 18 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#EA580C' }}>02</Text>
                    <Box style={{ flexDirection: 'column', gap: 6 }}>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A' }}>现在填一次，讲完再填一次</Text>
                        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.6 }}>同一套题，前后各一遍，中间隔 40 分钟</Text>
                    </Box>
                </Box>
                <Box style={{ flexDirection: 'row', gap: 18 }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#EA580C' }}>03</Text>
                    <Box style={{ flexDirection: 'column', gap: 6 }}>
                        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#0F172A' }}>我们要看的不是答案</Text>
                        <Text style={{ fontSize: 18, color: '#475569', lineHeight: 1.6 }}>是这 40 分钟里，你前后有没有变化</Text>
                    </Box>
                </Box>
            </Box>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, background: '#EFF6FF', borderRadius: 8, padding: '14px 20px' }}>
            <Text style={{ fontSize: 18, color: '#1D4ED8', lineHeight: 1.5 }}>扫不上或者没带手机的，跟旁边的同学说一声，我们有人帮你填。</Text>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 24, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#CBD5E1' }}>山东药品食品职业学院 · 质量管理系 ·「童健韶华」志愿服务队</Text>
        <Text style={{ fontSize: 14, color: '#CBD5E1' }}>02</Text>
    </Box>
</Slide>
