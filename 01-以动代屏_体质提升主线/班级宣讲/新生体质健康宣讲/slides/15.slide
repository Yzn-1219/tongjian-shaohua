<Slide style={{ padding: 60, background: '#FFFFFF', position: 'relative', fontFamily: 'Microsoft YaHei' }}>
    <Box style={{ flexDirection: 'column', height: '100%', gap: 22 }}>
        <Box style={{ flexDirection: 'column', gap: 12 }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#0F172A', lineHeight: 1.2 }}>1000 米和 800 米：快 50 秒，跳 20 分</Text>
            <Box style={{ height: 3, width: '100%', background: '#E2E8F0' }} />
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column', gap: 24, justifyContent: 'center' }}>
            <Table
                style={{ width: '100%', height: 264 }}
                defaultTextStyle={{ fontSize: 19, textAlign: 'center', color: '#1E293B' }}
                defaultCellStyle={{
                    border: {
                        left: { width: 1, color: '#E2E8F0' },
                        right: { width: 1, color: '#E2E8F0' },
                        top: { width: 1, color: '#E2E8F0' },
                        bottom: { width: 1, color: '#E2E8F0' },
                    },
                }}
                cells={[
                    [
                        { text: '单项得分', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1D4ED8' } } },
                        { text: '男生 1000 米', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1D4ED8' } } },
                        { text: '女生 800 米', textStyle: { bold: true, color: '#FFFFFF' }, cellStyle: { background: { color: '#1D4ED8' } } },
                    ],
                    [{ text: '100 分', textStyle: { bold: true, color: '#15803D' } }, { text: '3′17″', textStyle: { bold: true, color: '#15803D' } }, { text: '3′18″', textStyle: { bold: true, color: '#15803D' } }],
                    ['90 分', '3′27″', '3′30″'],
                    [{ text: '80 分（良好线）', textStyle: { bold: true, color: '#1D4ED8' } }, { text: '3′42″', textStyle: { bold: true, color: '#1D4ED8' } }, { text: '3′44″', textStyle: { bold: true, color: '#1D4ED8' } }],
                    ['70 分', '4′07″', '4′09″'],
                    [{ text: '60 分（及格线）', textStyle: { bold: true, color: '#EA580C' } }, { text: '4′32″', textStyle: { bold: true, color: '#EA580C' } }, { text: '4′34″', textStyle: { bold: true, color: '#EA580C' } }],
                ]}
            />
            <Box style={{ flexDirection: 'row', gap: 20 }}>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 8, paddingLeft: 20, borderLeft: '3px solid #1D4ED8' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1D4ED8', lineHeight: 1.3 }}>50 秒的差距</Text>
                    <Text style={{ fontSize: 17, color: '#475569', lineHeight: 1.6 }}>男生从 4′32″ 跑到 3′42″，正好从及格跨到良好。这 50 秒靠配速，不靠最后冲刺。</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 8, paddingLeft: 20, borderLeft: '3px solid #3B82F6' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#1D4ED8', lineHeight: 1.3 }}>起跑别冲</Text>
                    <Text style={{ fontSize: 17, color: '#475569', lineHeight: 1.6 }}>前 400 米冲太猛，后半程掉速比匀速慢得多。匀速跑完往往比忽快忽慢快十几秒。</Text>
                </Box>
                <Box style={{ flex: 1, flexDirection: 'column', gap: 8, paddingLeft: 20, borderLeft: '3px solid #EA580C' }}>
                    <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#EA580C', lineHeight: 1.3 }}>还有附加分</Text>
                    <Text style={{ fontSize: 17, color: '#475569', lineHeight: 1.6 }}>跑进 3′17″ 之后，每快 4 秒加 1 分，最多加 10 分。长跑是唯一能加到 10 分的项目。</Text>
                </Box>
            </Box>
        </Box>
    </Box>
    <Box style={{ position: 'absolute', left: 60, right: 60, bottom: 24, flexDirection: 'row', justifyContent: 'space-between' }}>
        <Text style={{ fontSize: 14, color: '#CBD5E1' }}>山东药品食品职业学院 · 质量管理系 ·「童健韶华」志愿服务队</Text>
        <Text style={{ fontSize: 14, color: '#CBD5E1' }}>15</Text>
    </Box>
</Slide>
