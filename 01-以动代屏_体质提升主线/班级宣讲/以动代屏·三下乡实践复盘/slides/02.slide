<Slide style={{ width: 1280, height: 720, backgroundColor: '#FBFAF7', padding: '60px', position: 'relative', display: 'flex', flexDirection: 'row' }}>
    <Box style={{ width: 300, display: 'flex', flexDirection: 'column', justifyContent: 'flex-start', paddingTop: 8 }}>
        <Text style={{ fontFamily: 'SimSun', fontSize: 46, fontWeight: 'bold', color: '#1F2937', lineHeight: 1.2 }}>
            目录
        </Text>
        <Text style={{ fontFamily: 'Arial', fontSize: 14, color: '#0D7D6A', letterSpacing: 4, marginTop: 12 }}>
            CONTENTS
        </Text>
        <Box style={{ width: 88, height: 3, background: '#0D7D6A', marginTop: 22 }} />
        <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 16, color: '#9CA3AF', lineHeight: 1.7, marginTop: 28 }}>
            四步方法
            <br />
            三样支撑
        </Text>
    </Box>

    <Box style={{ width: 1, height: 520, background: '#E0DDD5', marginRight: 54 }} />

    <Box style={{ flex: 1, display: 'flex', flexDirection: 'column', justifyContent: 'center' }}>
        {[
            { no: '01', name: '看题', note: '辨其出处，量己之力', page: '3' },
            { no: '02', name: '选题', note: '先聚其人，后定其向', page: '7' },
            { no: '03', name: '做题', note: '因地为形，不泥成法', page: '12' },
            { no: '04', name: '交卷', note: '先有其事，后有其文', page: '18' },
            { no: '05', name: '团队', note: '先做朋友，再做队员', page: '21' },
            { no: '06', name: '能力', note: '其事所需，其身所练', page: '24' },
            { no: '07', name: 'AI', note: '器可借力，用须守界', page: '27' }
        ].map((it, i) => (
            <Box key={i} style={{ display: 'flex', flexDirection: 'row', alignItems: 'baseline', paddingTop: 13, paddingBottom: 13, borderBottom: '1px solid #ECE9E2' }}>
                <Text style={{ fontFamily: 'Arial', fontSize: 18, fontWeight: 'bold', color: '#0D7D6A', width: 58 }}>
                    {it.no}
                </Text>
                <Text style={{ fontFamily: 'SimSun', fontSize: 26, fontWeight: 'bold', color: '#1F2937', width: 130 }}>
                    {it.name}
                </Text>
                <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 17, color: '#6B7280', flex: 1 }}>
                    {it.note}
                </Text>
                <Text style={{ fontFamily: 'Arial', fontSize: 17, color: '#B6B2A8' }}>
                    {it.page}
                </Text>
            </Box>
        ))}
        <Box style={{ display: 'flex', flexDirection: 'row', alignItems: 'baseline', paddingTop: 13, paddingBottom: 13 }}>
            <Text style={{ fontFamily: 'Arial', fontSize: 18, fontWeight: 'bold', color: '#C2410C', width: 58 }}>

            </Text>
            <Text style={{ fontFamily: 'SimSun', fontSize: 26, fontWeight: 'bold', color: '#1F2937', width: 130 }}>
                收尾
            </Text>
            <Text style={{ fontFamily: 'Microsoft YaHei', fontSize: 17, color: '#6B7280', flex: 1 }}>
                把目光挪到天空里去
            </Text>
            <Text style={{ fontFamily: 'Arial', fontSize: 17, color: '#B6B2A8' }}>
                30
            </Text>
        </Box>
    </Box>
</Slide>
