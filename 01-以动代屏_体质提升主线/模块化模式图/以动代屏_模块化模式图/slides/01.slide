<Slide style={{
    width: 1280,
    height: 720,
    background: '#F8FAFC',
    padding: '24px 56px',
    display: 'flex',
    flexDirection: 'column',
    gap: 10
}}>
    {/* A区 · 标题栏 */}
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end' }}>
        <Box style={{ flexDirection: 'column', gap: 3 }}>
            <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E3A8A', letterSpacing: 1 }}>
                一套模板 · 两个模块 · 三场落地
            </Text>
            <Text style={{ fontSize: 14, color: '#64748B' }}>
                以宣讲与运动守护青少年健康成长 ｜ "童健韶华"志愿服务队 · 2026 暑期"三下乡"社会实践
            </Text>
        </Box>
        <Box style={{ background: '#EFF6FF', padding: '5px 14px', borderRadius: 6, border: '1px solid #BFDBFE' }}>
            <Text style={{ fontSize: 12, color: '#1D4ED8', fontWeight: 'bold' }}>可拆 · 可组 · 可复制</Text>
        </Box>
    </Box>

    {/* 第 1 层 · 一套模板 */}
    <Box style={{
        background: 'linear-gradient(135deg, #1E3A8A 0%, #0284C7 100%)',
        borderRadius: 10,
        padding: '12px 22px',
        flexDirection: 'row',
        alignItems: 'center',
        gap: 18,
        boxShadow: '0 4px 12px rgba(2, 132, 199, 0.18)'
    }}>
        <Box style={{ background: 'rgba(255, 255, 255, 0.2)', padding: '5px 12px', borderRadius: 6 }}>
            <Text style={{ fontSize: 15, color: '#FFFFFF', fontWeight: 'bold' }}>01 ｜ 一套模板</Text>
        </Box>
        <Text style={{ fontSize: 14, color: '#E0F2FE', lineHeight: 1.5, flex: 1 }}>
            以青少年体质提升为目标的<strong>标准化服务模板</strong>：问卷调研 → 模块组合 → 现场实施 → 效果追踪，
            把零散的活动沉淀为可复制的完整流程，进入任何社区都无需从零开始。
        </Text>
    </Box>

    {/* 第 2 层 · 两个模块 */}
    <Box style={{ flexDirection: 'column', gap: 6 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ background: '#0284C7', padding: '3px 10px', borderRadius: 4 }}>
                <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 'bold' }}>02 ｜ 两个模块</Text>
            </Box>
            <Text style={{ fontSize: 12, color: '#64748B' }}>按社区条件自由组合，单上或叠加均可</Text>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 14 }}>
            {/* 模块一：宣讲 */}
            <Box style={{
                flex: 1,
                background: '#FFFFFF',
                borderRadius: 8,
                padding: '12px 16px',
                border: '1px solid #E2E8F0',
                borderLeft: '4px solid #0284C7',
                flexDirection: 'column',
                gap: 4
            }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 26, height: 26, borderRadius: 6, background: '#EFF6FF', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13 }}>🎤</Text>
                    </Box>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F172A' }}>宣讲模块</Text>
                    <Text style={{ fontSize: 12, color: '#0284C7', fontWeight: 'bold' }}>网络素养科普宣讲</Text>
                </Box>
                <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.5 }}>
                    沉迷危害情景警示 · 家庭用网微公约共签 · 护眼知识竞赛抢答<br />
                    <strong>解决"为什么沉迷"——从认知源头建立数字自律</strong>
                </Text>
            </Box>

            {/* 模块二：运动会 */}
            <Box style={{
                flex: 1,
                background: '#FFFFFF',
                borderRadius: 8,
                padding: '12px 16px',
                border: '1px solid #E2E8F0',
                borderLeft: '4px solid #F97316',
                flexDirection: 'column',
                gap: 4
            }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
                    <Box style={{ width: 26, height: 26, borderRadius: 6, background: '#FFF7ED', justifyContent: 'center', alignItems: 'center' }}>
                        <Text style={{ fontSize: 13 }}>🏃</Text>
                    </Box>
                    <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#0F172A' }}>运动会模块</Text>
                    <Text style={{ fontSize: 12, color: '#C2410C', fontWeight: 'bold' }}>体质提升趣味运动会</Text>
                </Box>
                <Text style={{ fontSize: 12, color: '#64748B', lineHeight: 1.5 }}>
                    低门槛趣味项目 · 亲子协作积分接力 · 11 天连续打卡激励<br />
                    <strong>解决"放下屏幕做什么"——以趣促动完成行为替代</strong>
                </Text>
            </Box>
        </Box>
    </Box>

    {/* 第 3 层 · 三场落地 */}
    <Box style={{ flexDirection: 'column', gap: 6 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            <Box style={{ background: '#059669', padding: '3px 10px', borderRadius: 4 }}>
                <Text style={{ fontSize: 13, color: '#FFFFFF', fontWeight: 'bold' }}>03 ｜ 三场落地</Text>
            </Box>
            <Text style={{ fontSize: 12, color: '#64748B' }}>同一套模板，因点施策，各展所长</Text>
        </Box>

        <Box style={{ flexDirection: 'row', gap: 14 }}>
            {/* 落地 1 */}
            <Box style={{
                flex: 1,
                background: '#FFFFFF',
                borderRadius: 8,
                padding: '10px',
                border: '1px solid #E2E8F0',
                flexDirection: 'column',
                gap: 6
            }}>
                <Image src="assets/site1.png" style={{ width: '100%', height: 84, borderRadius: 5, objectFit: 'cover' }} />
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                    <Box style={{ background: '#1E3A8A', padding: '2px 7px', borderRadius: 3 }}>
                        <Text style={{ fontSize: 10, color: '#FFFFFF', fontWeight: 'bold' }}>第 1 场</Text>
                    </Box>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0F172A' }}>黄家皂幼儿园</Text>
                </Box>
                <Box style={{ background: '#EFF6FF', padding: '3px 7px', borderRadius: 3 }}>
                    <Text style={{ fontSize: 10, color: '#0369A1', fontWeight: 'bold' }}>宣讲模块（单模块）</Text>
                </Box>
                <Text style={{ fontSize: 11, color: '#64748B', lineHeight: 1.4 }}>
                    室内场地、幼儿年龄，采用 40 分钟短课时精准适配。
                </Text>
            </Box>

            {/* 落地 2 */}
            <Box style={{
                flex: 1,
                background: '#FFFFFF',
                borderRadius: 8,
                padding: '10px',
                border: '1px solid #E2E8F0',
                flexDirection: 'column',
                gap: 6
            }}>
                <Image src="assets/site2.png" style={{ width: '100%', height: 84, borderRadius: 5, objectFit: 'cover' }} />
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                    <Box style={{ background: '#0284C7', padding: '2px 7px', borderRadius: 3 }}>
                        <Text style={{ fontSize: 10, color: '#FFFFFF', fontWeight: 'bold' }}>第 2 场</Text>
                    </Box>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0F172A' }}>蓝海社区</Text>
                </Box>
                <Box style={{ background: '#FFF7ED', padding: '3px 7px', borderRadius: 3 }}>
                    <Text style={{ fontSize: 10, color: '#C2410C', fontWeight: 'bold' }}>运动会模块（单模块）</Text>
                </Box>
                <Text style={{ fontSize: 11, color: '#64748B', lineHeight: 1.4 }}>
                    户外开阔场地，完整开展趣味运动会与亲子接力。
                </Text>
            </Box>

            {/* 落地 3 */}
            <Box style={{
                flex: 1,
                background: '#FFFFFF',
                borderRadius: 8,
                padding: '10px',
                border: '1px solid #E2E8F0',
                flexDirection: 'column',
                gap: 6
            }}>
                <Image src="assets/site3.png" style={{ width: '100%', height: 84, borderRadius: 5, objectFit: 'cover' }} />
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
                    <Box style={{ background: '#059669', padding: '2px 7px', borderRadius: 3 }}>
                        <Text style={{ fontSize: 10, color: '#FFFFFF', fontWeight: 'bold' }}>第 3 场</Text>
                    </Box>
                    <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#0F172A' }}>西海社区</Text>
                </Box>
                <Box style={{ background: '#ECFDF5', padding: '3px 7px', borderRadius: 3 }}>
                    <Text style={{ fontSize: 10, color: '#15803D', fontWeight: 'bold' }}>双模块叠加 + 反诈宣讲</Text>
                </Box>
                <Text style={{ fontSize: 11, color: '#64748B', lineHeight: 1.4 }}>
                    室内外分时段切换，多部门协同，一次进场多重成效。
                </Text>
            </Box>
        </Box>
    </Box>

    {/* 底部金句条 */}
    <Box style={{
        background: 'linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%)',
        borderRadius: 8,
        padding: '11px 22px',
        border: '1px solid #BFDBFE',
        borderLeft: '5px solid #1E3A8A'
    }}>
        <Text style={{ fontSize: 14, color: '#1E3A8A', lineHeight: 1.5 }}>
            一套模板、两个模块、三场落地——<strong>同一支队伍，因点施策、各展所长</strong>；
            用宣讲点亮认知，用运动强健体魄，这便是我们守护青少年健康成长的方式。
        </Text>
    </Box>
</Slide>
